<?xml version="1.0" encoding="utf-8"?>
<!--
  天演原生客户端 MSI（产品级，perUser）

  设计要点（都与「替换掉本地 tauri 版」直接相关）：

  1. **perUser**：装到 %LOCALAPPDATA%\Programs\Tianyan，不需要管理员权限、不弹 UAC，
     以后自研 updater 可以 `msiexec /i /qn` 静默升级。
  2. **独立目录**：不复用 tauri 版的 `D:\Program Files\Tianyan`——那里已经被历史
     产物污染（一堆 png 截图 + .playwright-mcp），混进去只会互相干扰。
  3. **同一套图标**：exe 图标由 build.rs 嵌入（复用 tauri/icons/icon.ico），MSI 的
     ARP 图标与开始菜单快捷方式用同一个文件，系统里看起来是同一个产品。
  4. **不碰数据目录**：安装/卸载只动 `%LOCALAPPDATA%\Programs\Tianyan` 下的文件，
     用户数据在 `D:\tianyan`（配置里的 storage.data_dir），卸载不会删。
  5. **MajorUpgrade**：同 UpgradeCode 的新版本会替换旧版本（实测 0.1.1→0.1.3 静默
     升级无残留双条目）。

  构建：**不要直接调 wix**（版本号与产物名会与 Cargo.toml 漂移）。
  走打包脚本，它从 ``gui-native/Cargo.toml`` 读版本、补成 4 段后经 ``-d ProductVersion=``
  注入本文件，并按同一版本命名产物：
    pwsh -File gui-native\installer\build-msi.ps1
  版本一致性由 ``scripts/check-version.ps1``（进 ``scripts/test.ps1 lint`` 门禁）校验。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="天演"
      Manufacturer="Tianyan"
      Version="$(var.ProductVersion)"
      UpgradeCode="8E4B2A1C-7F3D-4E5B-9A6C-1D2E3F4A5B6C"
      Scope="perUser"
      Language="2052"
      Codepage="65001">

    <!-- AllowSameVersionUpgrades：同版本号的重新构建（改了 bug 但版本仍是 1.1.0）也要能覆盖安装。
         原因：WiX 未显式指定 ProductCode 时每次 build 生成新 GUID，而 MSI 把「同版本 + 不同
         ProductCode」判为另一个产品 → 默认直接报 1638（已安装此产品的另一个版本）。
         开了这个开关，同版本走 MajorUpgrade 序（先卸旧版、再装新版），用户数据在
         D:\tianyan 不受影响。不同版本号的行为不变。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更新版本的天演，无需降级安装。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ARP（控制面板）里的图标。取自本 crate 的 `assets/icon.ico`（与 build.rs 嵌进
         exe 的是同一份文件）——不再引用 `tauri/icons/`，否则删 tauri 目录时打包会断。 -->
    <Icon Id="AppIcon" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- 「设置 → 应用」里显示的版本。
         Windows Installer 的 `ProductVersion` **按规范必须是 4 段**（`x.y.z.w`，
         用于升级比较），所以本包的 ProductVersion 是 `1.1.0.0`；但**产品版本是
         3 段的「1.1.0」**（与「关于」页、`/health`、exe 文件属性一致）。
         这里显式覆盖 ARP 的 `DisplayVersion`，让用户看到的每一处都是 1.1.0
         ——由 `build-msi.ps1` 从 `gui-native/Cargo.toml` 读出后经
         `-d DisplayVersion=` 注入。 -->
    <Property Id="DisplayVersion" Value="$(var.DisplayVersion)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Tianyan" />
      </Directory>
    </StandardDirectory>

    <!-- 开始菜单：单独一个「天演」文件夹，避免和 tauri 版（Tianyan）混放 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="天演" />
    </StandardDirectory>

    <!-- 桌面快捷方式：perUser 上下文的 `DesktopFolder` 解析到**当前用户**桌面
         （`CommonDesktopFolder` 才是「所有人」桌面，不要混用）。 -->
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="天演（GPUI 原生端）" Level="1">
      <Component Id="MainExe" Directory="INSTALLFOLDER" Guid="*">
        <File Id="MainExeFile"
              Source="..\target\release\tianyan-gui-native.exe"
              KeyPath="yes">
          <!-- ⚠️ 快捷方式必须用**常规**（非 advertised）方式，`Advertise="yes"` 是
               白板图标的真凶：

               advertised shortcut 的 .lnk 里**不写目标路径** —— 只写 MSI 的
               advertise 数据（Feature/Component 描述），由 shell 在点击时通过
               Windows Installer 解析。实测装完读 .lnk：
                   TargetPath   : （空）
                   IconLocation : ',0'      ← 空路径 + 索引 0 = 白板
               「开始菜单搜索里显示 天演 / 应用 + 白板图标」正是这个（用户截图）。

               常规快捷方式会把 TargetPath 与 IconLocation 都写实
               （`<exe>,0`），图标直接取 exe 资源（build.rs 用 winres 嵌入，
               已实测 exe 的 32×32 图标正常），不依赖 Installer 的图标缓存，
               也不依赖 shell 去解析 advertise 数据。

               `WorkingDirectory` 必给：应用内若有相对路径（资源 / 日志）需要它。 -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="AppMenuFolder"
                    Name="天演"
                    Description="天演 · GPUI 原生端"
                    WorkingDirectory="INSTALLFOLDER" />
          <!-- 桌面快捷方式（与开始菜单同一个 exe、同一套图标） -->
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="天演"
                    Description="天演 · GPUI 原生端"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>
    </Feature>
  </Package>
</Wix>

