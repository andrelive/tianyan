# ===========================================
# Tianyan 环境变量配置示例
# ===========================================
# 将此文件复制为 .env 并填入实际值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制系统

# -------------------------------------------
# API 密钥配置
# -------------------------------------------

# OpenAI API 密钥
# 用于访问 OpenAI 的 GPT 系列模型和 Embedding 服务
# 获取地址：https://platform.openai.com/api-keys
TIANYAN_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Anthropic API 密钥
# 用于访问 Claude 系列模型
# 获取地址：https://console.anthropic.com/
TIANYAN_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# DeepSeek API 密钥
# 用于访问 DeepSeek 模型
# 获取地址：https://platform.deepseek.com/
TIANYAN_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# -------------------------------------------
# 存储配置
# -------------------------------------------

# 数据存储目录
# 默认值：~/.tianyan（用户主目录下的 .tianyan 文件夹）
# Windows 示例：C:\Users\用户名\.tianyan
# Linux/macOS 示例：/home/用户名/.tianyan
TIANYAN_DATA_DIR=~/.tianyan

# Qdrant 向量数据库地址
# 用于存储和检索向量嵌入
# 默认值：http://localhost:6333
TIANYAN_QDRANT_URL=http://localhost:6333

# Qdrant API 密钥（可选）
# 如果 Qdrant 配置了 API 密钥认证，请在此设置
TIANYAN_QDRANT_API_KEY=

# -------------------------------------------
# 日志配置
# -------------------------------------------

# 日志级别
# 可选值：trace, debug, info, warn, error
# 默认值：info
TIANYAN_LOG_LEVEL=info

# 日志格式
# 可选值：text, json
# 默认值：text
TIANYAN_LOG_FORMAT=text

# -------------------------------------------
# 模型配置
# -------------------------------------------

# 默认聊天模型
# 默认值：gpt-4
TIANYAN_DEFAULT_CHAT_MODEL=gpt-4

# 默认嵌入模型
# 默认值：text-embedding-3-small
TIANYAN_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# -------------------------------------------
# 安全配置
# -------------------------------------------

# 允许执行的技能安全级别
# 可选值：safe, moderate, dangerous
# 默认值：moderate
TIANYAN_SKILL_SECURITY_LEVEL=moderate
