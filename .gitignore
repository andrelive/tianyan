# Rust build output
/target
# gui-native 是独立 workspace（自带 [workspace]），有自己的 target，根规则不覆盖它
gui-native/target/
*.wixpdb
# 打包产物不进仓（wix build 生成，按 README 的「出包一条链」可复现）
gui-native/installer/*.msi

# Node.js
node_modules/
dist/
test-results/
playwright-report/
coverage/
*.tsbuildinfo

# Tianyan runtime data (accidental writes to repo root)
~/
# Local config (contains secrets; keep local, tianyan.toml.example as template)
/tianyan.toml
*.db
*.db-wal
*.db-shm

# IDE / tooling
.omo/
.trae/
.idea/
.vscode/
.codegraph/
*.log
# Playwright MCP runtime artifacts (console logs, page snapshots)
.playwright-mcp/

# Temporary workspace (audit notes, scratch plans)
.scratch/

# Tauri 签名密钥（私钥，禁止提交）
*.key
*.key.pub

# OS
.DS_Store
Thumbs.db
