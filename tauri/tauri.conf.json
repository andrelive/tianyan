{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianyan",
  "version": "0.1.0",
  "identifier": "com.tianyan.app",
  "build": {
    "beforeBuildCommand": "powershell -Command \"cd ../gui; trunk build --release\"",
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "天演 Tianyan",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
